# ==============================================================================
# NyayaSutra Root Environment Template
# Copy this file to .env or edit backend/.env:
#   copy .env.example .env     (Windows PowerShell / CMD)
#   cp .env.example .env       (macOS / Linux / Bash)
# ==============================================================================

# Google AI Studio Gemini API Key (Get free tier at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=nyayasutra

# Optional frontend proxy override (defaults to http://backend:8000 in Docker)
# VITE_PROXY_BACKEND_URL=http://backend:8000
